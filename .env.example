# Torgash — the installer (php artisan torgash:install, or /install in a
# browser) writes the lines marked "installer" itself. Everything else can
# stay as it is.

APP_NAME=Torgash
APP_ENV=production
# installer: made once, never changed — it encrypts what is stored
APP_KEY=
APP_DEBUG=false
# installer
APP_URL=https://shop.example.com

# The base language of the engine; a storefront's own language is set in the admin.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# installer. PostgreSQL only, created with the ICU locale `und` — the installer
# does that; see INSTALL.md when you create the database yourself.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=torgash
DB_USERNAME=torgash
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Background work (letters, imports). `scheduler`: the cron line starts a short
# worker every minute; `external`: a worker of its own (systemd, supervisor).
QUEUE_CONNECTION=database
QUEUE_WORKER=scheduler

# Admin → Cache and sessions switches these (file, database, Redis or Valkey).
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is set in the admin as well; these are the defaults until then.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where the shop's files (photos, attachments, uploads) live: `local` (the
# server's own disk, served from /storage) or `s3` (any S3-compatible bucket:
# AWS, Cloudflare R2, Backblaze B2, MinIO). Copy first, then switch:
#   php artisan torgash:files-copy --to=s3
# See Admin → System → File storage and config/filesystems.php.
TORGASH_STORAGE=local
# Public address the pictures are read from: the bucket's public domain or a
# CDN in front of it (falls back to AWS_URL).
TORGASH_STORAGE_URL=
# Per-file ACLs: true for AWS, false for R2 (a bucket there is public as a whole).
TORGASH_STORAGE_ACL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# A second, PRIVATE bucket for attachments and customers' files. Required where
# a bucket is published as a whole (R2, B2); empty = the same bucket, private/.
AWS_PRIVATE_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# pg_dump / pg_restore for backups (System → Backups); empty = on the PATH
TORGASH_PG_BIN=

# FrankenPHP worker mode: the admin endpoint that restarts every worker after
# an update, e.g. http://localhost:2019/frankenphp/workers/restart. Empty is
# fine — each worker notices the new code by itself, one request later.
TORGASH_WORKER_RESTART_URL=

# Updates: a GitHub repository (owner/repo) whose releases are asked when the
# update server does not answer — a shop that cannot reach extago.com but can
# reach GitHub. Empty: the built-in extago/torgash. A token only for a private
# repository.
TORGASH_GITHUB_REPO=
TORGASH_GITHUB_TOKEN=
# Only on the machine that publishes releases (torgash:release --github).
TORGASH_GITHUB_PUBLISH_TOKEN=

# The audit trail (torgash.guard) — here and not in the admin, so the people it
# records cannot switch it off or shorten it. 0 days keeps everything; IGNORE is
# a comma-separated list of tables.
GUARD_AUDIT=true
GUARD_AUDIT_RETENTION_DAYS=180
GUARD_AUDIT_MAX_PER_REQUEST=200
GUARD_AUDIT_IGNORE=
